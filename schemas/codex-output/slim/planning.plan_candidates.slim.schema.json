{
  "type": "object",
  "required": ["chapterNumber", "candidates"],
  "properties": {
    "chapterNumber": { "type": "integer" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "markdown"],
        "properties": {
          "id": { "type": "string" },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "summary": { "type": "string" },
          "markdown": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
