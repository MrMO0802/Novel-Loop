NOVEL_LOOP_PROJECTS_ROOT=./projects

# Default provider remains mock. Real provider is OpenAI-compatible.
NLE_REAL_API_KEY=
NLE_REAL_MODEL=
NLE_REAL_BASE_URL=https://api.openai.com/v1
NLE_REAL_TIMEOUT_MS=60000
NLE_REAL_MAX_RETRIES=2
NLE_REAL_RETRY_BASE_MS=500

# Optional cost estimate inputs, USD per 1M tokens.
NLE_REAL_INPUT_COST_PER_1M=
NLE_REAL_OUTPUT_COST_PER_1M=

# Set true to avoid storing prompt request/response text artifacts.
NLE_REDACT_PROMPT_ARTIFACTS=false
