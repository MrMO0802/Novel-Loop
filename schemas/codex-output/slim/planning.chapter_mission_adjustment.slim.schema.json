{
  "type": "object",
  "required": [
    "id",
    "chapterNumber",
    "chapterFunction",
    "requiredObjectives",
    "debtsToPayOrAdvance",
    "debtsToIntroduce",
    "participatingCharacterIds",
    "charactersToIntroduce",
    "characterDeltas",
    "readerInformationDelta",
    "forbiddenMoves",
    "targetEmotionalCurve",
    "targetWordCount"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "chapterNumber": { "type": "integer", "minimum": 1 },
    "chapterFunction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "requiredObjectives": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "text", "type", "priority"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "type": {
            "type": "string",
            "enum": [
              "plot",
              "character",
              "relationship",
              "world",
              "debt",
              "foreshadowing",
              "reader"
            ]
          },
          "priority": {
            "type": "string",
            "enum": ["must", "should", "could"]
          }
        },
        "additionalProperties": false
      }
    },
    "debtsToPayOrAdvance": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "debtsToIntroduce": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["type", "promise", "importance"],
        "properties": {
          "type": { "type": "string", "minLength": 1, "maxLength": 100 },
          "promise": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "importance": { "type": "number", "minimum": 1, "maximum": 10 }
        },
        "additionalProperties": false
      }
    },
    "participatingCharacterIds": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "charactersToIntroduce": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["characterId", "name", "role"],
        "properties": {
          "characterId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "role": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "additionalProperties": false
      }
    },
    "characterDeltas": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["characterId", "from", "to", "evidenceRequired"],
        "properties": {
          "characterId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "from": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "to": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidenceRequired": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "additionalProperties": false
      }
    },
    "readerInformationDelta": {
      "type": "object",
      "required": [
        "newKnowledge",
        "newSuspicions",
        "questionsToMaintain",
        "questionsToAnswer"
      ],
      "properties": {
        "newKnowledge": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "newSuspicions": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "questionsToMaintain": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "questionsToAnswer": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      },
      "additionalProperties": false
    },
    "forbiddenMoves": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "targetEmotionalCurve": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "targetWordCount": {
      "anyOf": [
        { "type": "integer", "minimum": 1, "maximum": 1000000 },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}
