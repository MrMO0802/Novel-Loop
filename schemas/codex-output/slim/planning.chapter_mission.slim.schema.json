{
  "type": "object",
  "required": ["chapterNumber", "chapterFunction", "objectives", "debtsToPayOrAdvance", "debtsToIntroduce", "participatingCharacterIds", "charactersToIntroduce", "characterDeltas", "readerKnowledge", "readerQuestions", "forbiddenMoves"],
  "properties": {
    "chapterNumber": { "type": "integer", "minimum": 1 },
    "chapterFunction": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "debtsToPayOrAdvance": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "debtsToIntroduce": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["type", "promise", "importance"],
        "properties": {
          "type": { "type": "string", "minLength": 1, "maxLength": 100 },
          "promise": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "importance": { "type": "number", "minimum": 1, "maximum": 10 }
        },
        "additionalProperties": false
      }
    },
    "participatingCharacterIds": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "charactersToIntroduce": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["characterId", "name", "role"],
        "properties": {
          "characterId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "role": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "additionalProperties": false
      }
    },
    "characterDeltas": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["characterId", "from", "to", "evidenceRequired"],
        "properties": {
          "characterId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "from": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "to": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidenceRequired": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "additionalProperties": false
      }
    },
    "readerKnowledge": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "readerQuestions": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "forbiddenMoves": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  },
  "additionalProperties": false
}
