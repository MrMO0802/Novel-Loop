{
  "name": "novel-loop-engine",
  "version": "2.5.0-rc.1",
  "description": "Local-first CLI skeleton for the Novel Loop Engine.",
  "type": "module",
  "exports": {
    "./author-facing": {
      "types": "./dist/authorFacingText.d.ts",
      "import": "./dist/authorFacingText.js"
    },
    "./desktop": {
      "types": "./dist/desktop/index.d.ts",
      "import": "./dist/desktop/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "author-facing": [
        "dist/authorFacingText.d.ts"
      ],
      "desktop": [
        "dist/desktop/index.d.ts"
      ]
    }
  },
  "bin": {
    "novel-loop": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:diff": "git diff --check",
    "prepack": "corepack pnpm --silent build",
    "test": "vitest run",
    "novel-loop": "node dist/cli/index.js",
    "clean:demo": "node scripts/clean-generated.mjs demo",
    "clean:test": "node scripts/clean-generated.mjs test",
    "clean:generated": "node scripts/clean-generated.mjs generated",
    "demo:codex-single-chapter": "node scripts/demo-codex-single-chapter.mjs",
    "demo:codex-multi-chapter": "node scripts/demo-codex-multi-chapter.mjs",
    "desktop:dev": "pnpm build && pnpm --dir apps/desktop dev",
    "desktop:build": "pnpm build && pnpm --dir apps/desktop build",
    "desktop:test": "pnpm --dir apps/desktop test",
    "release:checklist": "node scripts/print-release-checklist.mjs"
  },
  "files": [
    "dist/",
    "prompts/",
    "schemas/",
    "examples/",
    "fixtures/",
    "benchmarks/",
    "scripts/",
    "docs/operations/",
    "docs/release/",
    "docs/releases/",
    "README.md",
    "CHANGELOG.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.12.1"
}
