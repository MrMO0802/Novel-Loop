{
  "name": "@novel-loop/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:required": "NOVEL_LOOP_REQUIRE_ELECTRON_SMOKE=1 playwright test tests/e2e",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm test:e2e",
    "verify:release": "pnpm check && pnpm test && pnpm build && pnpm test:e2e:required"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "entities": "^6.0.1",
    "novel-loop-engine": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "43.2.0",
    "electron-vite": "5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.12.1"
}
